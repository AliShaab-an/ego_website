DB_HOST=localhost
DB_USER=root
DB_PASSWORD=''
DB_NAME=ego
DB_PORT=3306

# ============================================
# Cybersource Secure Acceptance Configuration
# ============================================

# Profile ID (find in Cybersource Business Center → Secure Acceptance Settings)
CYBS_PROFILE_ID=your_profile_id_here

# Access Key (generate in Cybersource Business Center → Security Keys)
CYBS_ACCESS_KEY=your_access_key_here

# Secret Key (KEEP THIS SECURE - never commit to version control)
CYBS_SECRET_KEY=your_secret_key_here

# Test Environment Endpoint (use during development/testing)
CYBS_ENDPOINT=https://testsecureacceptance.cybersource.com/pay

# Production Environment Endpoint (uncomment when going live)
# CYBS_ENDPOINT=https://secureacceptance.cybersource.com/pay

# ============================================
# Webhook URLs to configure in Cybersource:
# Success URL: https://yourdomain.com/api/payment/webhook/cybersource
# Failure URL: https://yourdomain.com/api/payment/webhook/cybersource
# Cancel URL:  https://yourdomain.com/api/payment/webhook/cybersource

# ============================================
# SMTP Email Configuration
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@yourdomain.com
# ============================================
